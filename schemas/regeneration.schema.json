{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regeneration.schema.json",
  "title": "Public layer regeneration contract",
  "type": "object",
  "required": ["schema_version", "region_id", "enabled", "min_interval_seconds", "outputs", "commands"],
  "properties": {
    "schema_version": {"const": 1},
    "region_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "enabled": {"type": "boolean"},
    "min_interval_seconds": {"type": "integer", "minimum": 300},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[^/].+\\.geojson$"}},
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["command"],
        "properties": {
          "name": {"type": "string"},
          "cwd": {"type": "string"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
