{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/regional-map-framework/deployment-bundle.schema.json",
  "title": "Regional Map Framework deployment bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "core_version", "created_at", "default_region", "regions", "files", "data"],
  "properties": {
    "schema_version": {"const": 1},
    "core_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "default_region": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    },
    "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
    "data": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data_mode", "configuration_sha256", "outputs", "validation"],
        "properties": {
          "data_mode": {"enum": ["external", "pipeline"]},
          "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
          "validation": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
