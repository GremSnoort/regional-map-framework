{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region.schema.json",
  "title": "Regional Map Framework package",
  "type": "object",
  "required": ["schema_version", "core_version", "region_id", "lifecycle", "data_mode", "title", "page_title", "view", "layers"],
  "properties": {
    "schema_version": {"const": 2},
    "core_version": {"const": "2.1.0"},
    "region_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "lifecycle": {"enum": ["draft", "production"]},
    "data_mode": {"enum": ["external", "pipeline"]},
    "title": {"type": "string", "minLength": 1},
    "page_title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "source_note": {"type": "string"},
    "status_note": {"type": "string"},
    "view": {
      "type": "object",
      "required": ["center", "zoom", "min_zoom", "max_zoom"],
      "properties": {
        "center": {"type": "array", "prefixItems": [{"type": "number", "minimum": -90, "maximum": 90}, {"type": "number", "minimum": -180, "maximum": 180}], "minItems": 2, "maxItems": 2},
        "zoom": {"type": "number"}, "min_zoom": {"type": "number"}, "max_zoom": {"type": "number"}
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["file", "label"],
        "properties": {
          "file": {"type": "string", "pattern": "^data/(?!.*\\.\\.)[^/].+\\.geojson$"},
          "label": {"type": "string", "minLength": 1},
          "renderer": {"enum": ["auto", "points", "lines", "polygons", "choropleth", "density", "ranking"]},
          "geometry_types": {"type": "array", "items": {"enum": ["Point", "MultiPoint", "LineString", "MultiLineString", "Polygon", "MultiPolygon"]}},
          "required_properties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "numeric_properties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "unique_by": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "required_for_production": {"type": "boolean"},
          "default_visible": {"type": "boolean"},
          "interactive": {"type": "boolean"}, "z_index": {"type": "integer"},
          "fit_bounds": {"type": "boolean"},
          "min_zoom": {"type": "number"}, "max_zoom": {"type": "number"},
          "title_field": {"type": "string"}, "value_field": {"type": "string"}, "size_field": {"type": "string"},
          "category_field": {"type": "string"}, "categories": {"type": "object"},
          "label_field": {"type": "string"}, "label_min_field": {"type": "string"}, "label_min_value": {"type": "number"},
          "popup_fields": {"type": "array"}, "bins": {"type": "array"}, "style": {"type": "object"}, "table": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "expected": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  },
  "additionalProperties": true
}
