# Copy to /etc/regional-map-framework.env and keep it owned by root:root, mode 0600.
# This file must not contain shell syntax such as `export`, command substitutions or quotes.

PYTHONDONTWRITEBYTECODE=1
RMF_CONTENT_ROOT=/srv/regional-map-deployment
RMF_RUNTIME_ROOT=/var/lib/regional-map-framework/regions
RMF_AUTH_FILE=/var/lib/regional-map-framework/users.json
RMF_COOKIE_SECURE=1
RMF_TRUST_PROXY=1
RMF_SESSION_SECONDS=43200

# Leave remote regeneration disabled until every enabled region has a reviewed
# pipeline/regeneration.json and writable, non-symlinked data directory.
RMF_ALLOW_REGENERATION=0
RMF_REGENERATION_TIMEOUT_SECONDS=3600
