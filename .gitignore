__pycache__/
*.py[cod]
.venv/
/deployment/
.idea/
.vscode/
.DS_Store

# Runtime, credentials and transactional state
/.runtime/
**/.runner.lock
**/.regeneration.lock
**/.regeneration-*/
**/.data.regeneration.backup/
**/.regional-build-*/
**/.outputs.backup/
.*.data.backup/

# Regional data are deliberately kept outside the public repository.
regions/*/data
regions/*/sources/*
!regions/*/sources/README.md
regions/*/pipeline/cache/
regions/*/pipeline/outputs/
regions/*/pipeline/inputs.lock.json
regions/*/pipeline/build_manifest.json
regions/*/build_manifest.json
regions/*/.runtime/

# Large geodata must be downloaded or mounted, never committed by accident.
*.osm.pbf
*.pbf
*.gpkg
*.fgb
*.mbtiles
*.tif
*.tiff
